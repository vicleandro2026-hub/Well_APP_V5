  "narrative": {
    "northStar": "Identidade V5 da Well",
    "overview": "Expansão para navegador da identidade V5 fornecida pelo usuário: fundo original Well, marca real, carvão e ouro velho. Esses recursos são a autoridade visual; os aplicativos nativos V3, V4 e V5 permanecem preservados.\n\nA interface oferece uma moldura escura e discreta para as fotos de imóveis. Superfícies tonais, divisórias finas e ferramentas compactas sustentam a operação. O ouro orienta ações e seleção sem competir com a foto.",
    "keyCharacteristics": [
      "Fundo e logos originais da Well.",
      "Carvão em camadas, texto quente e ouro velho.",
      "Densidade de ferramenta, com foto como conteúdo principal.",
      "Estados explícitos e foco visível."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Seleção combina ouro com contorno, fundo e estado acessível; não depende apenas da cor.",
        "section": "colors"
      },
      {
        "name": "The Frame Rule",
        "body": "A moldura da interface mantém seu contraste discreto para a fotografia continuar sendo o destaque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preservar fundo, marca e logos originais da Well.",
      "**Do** usar ouro para ações, seleção e foco dentro da paleta existente.",
      "**Do** combinar texto, ícone e estado acessível para comunicar seleção e resultado.",
      "**Do** priorizar a leitura da foto e a previsibilidade dos ajustes globais."
    ],
    "donts": [
      "**Don't** substituir a identidade V5 por novas cores de marca ou logos inventados.",
      "**Don't** inserir fotos fictícias no lote real do usuário.",
      "**Don't** exportar a moldura ou a seleção que só existe na prévia.",
      "**Don't** tratar zoom e pan da prévia como alterações da resolução de exportação."
    ]
  }
